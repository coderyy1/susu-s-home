# =====================================
# 统一换行符为 LF，跨平台一致
# =====================================
* text=auto eol=lf

# 脚本文件（确保部署环境识别）
*.sh text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.env text eol=lf

# =====================================
# 保证编码为 UTF-8
# =====================================
*.js text working-tree-encoding=UTF-8
*.ts text working-tree-encoding=UTF-8
*.vue text working-tree-encoding=UTF-8
*.json text working-tree-encoding=UTF-8
*.env text working-tree-encoding=UTF-8
*.md text working-tree-encoding=UTF-8

# =====================================
# 二进制文件（禁用自动 diff/merge）
# =====================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.webp binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.pdf binary
*.zip binary

# =====================================
# 保留空文件夹（如 uploads/, public/images/ 等）
# =====================================
*.gitkeep text